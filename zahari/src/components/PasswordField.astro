---
interface Props {
  label?: string;
  name?: string;
  id?: string;
  confirm?: boolean;
  current?: boolean;
}
const {
  label = "Password",
  name = "password",
  id = name,
  confirm = false,
  current = false,
} = Astro.props;
---

<div class="field">
  <label for={id}>{label}</label>
  <div class="password-wrap">
    <input
      type="password"
      id={id}
      name={name}
      required
      minlength={current ? undefined : 7}
      maxlength={current ? 128 : 18}
      autocomplete={current ? "current-password" : "new-password"}
      data-password-check={!confirm && !current ? "" : undefined}
      data-confirm={confirm ? "" : undefined}
      aria-describedby={!confirm && !current ? `${id}-hint` : undefined}
    />
    <button
      type="button"
      data-show-password
      aria-label={`Show ${label.toLowerCase()}`}
    >
      Show
    </button>
  </div>
  {!confirm && !current && (
    <small id={`${id}-hint`} data-password-hint>
      7–18 characters, with a letter and a number.
    </small>
  )}
</div>
