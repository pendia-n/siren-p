---
import Icon from "./Icon.astro";
interface Props {
  sample?: boolean;
  asset?: string;
  modelUrl?: string;
  location?: string;
  buried?: boolean;
  sceneAsset?: string;
}
const {
  sample = false,
  asset = "BTC",
  modelUrl,
  location = "lowland",
  buried = false,
  sceneAsset,
} = Astro.props;
---

<section
  class="world-viewer"
  data-viewer
  data-sample={String(sample)}
  data-model-url={modelUrl ?? ""}
  data-location-initial={location}
  data-buried={String(buried)}
  data-scene-asset={sceneAsset ?? ""}
  aria-label={
    sample ? "Interactive sample artwork" : `Interactive ${asset} world`
  }
>
  <div class="viewer-top">
    <span class="viewer-label">
      {sample ? "ZAHARI" : asset} <span>/</span>{" "}
      {sample ? "SAMPLE WORLD" : "COIN WORLD"}
    </span>
    <span class="pill">
      <span class="status-dot"></span> Art preview
    </span>
  </div>
  <div
    class="canvas-wrap"
    data-canvas
    tabindex="0"
    role="region"
    aria-label="3D artwork. Drag to orbit, scroll or pinch to zoom. Use arrow keys to pan."
  ></div>
  <div class="viewer-loading" data-loading role="status">
    <span class="loader-ring"></span>
    <p data-progress>Opening the artwork…</p>
    <button type="button" class="button secondary small" data-retry hidden>
      Try again
    </button>
  </div>
  {sample && (
    <div class="location-controls" role="group" aria-label="Sample location">
      <button type="button" data-location="lowland" aria-pressed="true">
        Lowland
      </button>
      <button type="button" data-location="pacific" aria-pressed="false">
        Pacific
      </button>
      <button type="button" data-location="sky" aria-pressed="false">
        Sky
      </button>
    </div>
  )}
  <div class="viewer-bottom">
    <div class="light-controls" role="group" aria-label="Scene lighting">
      <button type="button" data-light="dawn" aria-pressed="false">
        Dawn
      </button>
      <button type="button" data-light="day" aria-pressed="false">
        Daylight
      </button>
      <button type="button" data-light="dusk" aria-pressed="false">
        Dusk
      </button>
      <button type="button" data-light="night" aria-pressed="false">
        Night
      </button>
    </div>
    <div class="viewer-actions">
      <button
        data-view-action="rotate"
        title="Start rotation"
        aria-label="Start rotation"
        aria-pressed="false"
      >
        <Icon name="rotate" />
      </button>
      <button
        data-view-action="reset"
        title="Reset view"
        aria-label="Reset view"
      >
        <Icon name="reset" />
      </button>
      <button
        data-view-action="capture"
        title="Save image"
        aria-label="Save image"
      >
        <Icon name="camera" />
      </button>
    </div>
  </div>
  <p class="viewer-hint">Drag to discover · Scroll or pinch to get closer</p>
</section>
<script>
  import "../scripts/viewer";
</script>
