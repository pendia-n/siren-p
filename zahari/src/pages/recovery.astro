---
import Layout from "../layouts/Layout.astro";
import PasswordField from "../components/PasswordField.astro";
import PasscodeField from "../components/PasscodeField.astro";
---

<Layout title="Recover account">
  <section class="auth-layout">
    <div class="auth-intro">
      <p class="eyebrow">FIND YOUR WAY BACK</p>
      <h1>
        A fresh start.
        <br />
        The same you.
      </h1>
      <p>
        Your recovery passcode helps you set a new password without losing your
        account.
      </p>
      <a class="text-link" href="/signin">
        ← Back to sign in
      </a>
    </div>
    <div class="form-card" data-recovery>
      <p class="eyebrow" data-recovery-step>
        STEP 1 OF 3
      </p>
      <h2>Recover your account</h2>
      <form method="post" data-recover-stage="start">
        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            required
            autocomplete="username"
            autocapitalize="none"
            spellcheck={false}
            maxlength="24"
          />
        </div>
        <p class="form-status" role="status"></p>
        <button class="button full" type="submit">
          Find recovery options
        </button>
      </form>
      <form method="post" data-recover-stage="verify" hidden>
        <p>Select a recovery method enabled on your account.</p>
        <div class="field">
          <label for="method">Recovery method</label>
          <select id="method" required>
            <option value="">Choose a method</option>
            <option value="passcode">Recovery passcode</option>
          </select>
        </div>
        <div data-verification-input hidden>
          <PasscodeField id="verify-passcode" generate={false} />
          <p class="form-status" role="status"></p>
          <button class="button full" type="submit">
            Verify passcode
          </button>
        </div>
      </form>
      <form method="post" data-recover-stage="complete" hidden>
        <p>
          Choose a new password and save a replacement recovery passcode. All
          existing sessions will be signed out.
        </p>
        <PasswordField label="New password" id="new-password" />
        <PasswordField
          label="Confirm new password"
          name="confirmation"
          confirm
        />
        <PasscodeField
          id="new-passcode"
          label="Replacement recovery passcode"
        />
        <label class="checkbox">
          <input type="checkbox" required />
          <span>I have saved my replacement passcode.</span>
        </label>
        <p class="form-status" role="status"></p>
        <button class="button full" type="submit">
          Reset password
        </button>
      </form>
      <a
        href="/recovery"
        class="text-link restart-link"
        data-recovery-restart
        hidden
      >
        Start again
      </a>
    </div>
  </section>
</Layout>
