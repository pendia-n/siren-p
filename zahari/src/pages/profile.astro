---
import Layout from "../layouts/Layout.astro";
import { membership, activeMembership } from "../lib/product";
const user = Astro.locals.user!;
const member = await membership(user.id);
const date = (stamp: number) =>
  new Date(stamp * 1000).toLocaleDateString("en", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Layout title="Your profile">
  <section class="account-page page-width">
    <p class="eyebrow">YOUR ACCOUNT</p>
    <h1>A little introduction.</h1>
    <div class="profile-card">
      <div class="avatar" aria-hidden="true">
        {user.username[0].toUpperCase()}
      </div>
      <div>
        <h2>@{user.username}</h2>
        <p>Joined {date(user.createdAt)}</p>
      </div>
      <a class="button secondary" href="/studio">
        Return to the sample
      </a>
    </div>
    <div class="settings-grid">
      <section class="settings-card">
        <h2>Account security</h2>
        <dl>
          <div>
            <dt>Recovery passcode</dt>
            <dd>{user.hasPasscode ? "Enabled" : "Not enabled"}</dd>
          </div>
          <div>
            <dt>This session expires</dt>
            <dd>{date(user.sessionExpiresAt)} (UTC)</dd>
          </div>
        </dl>
        <div class="link-row">
          <a href="/security#password" class="text-link">
            Change password ↗
          </a>
          <a href="/security#recovery" class="text-link">
            Manage recovery ↗
          </a>
        </div>
      </section>
      <section class="settings-card">
        <p class="eyebrow">YOUR EXPERIENCE</p>
        <h2>
          {activeMembership(member)
            ? `${member?.tier} membership`
            : "Sample preview"}
        </h2>
        <p>
          {activeMembership(member)
            ? "Your coin worlds are available in Explore."
            : "Your account includes the interactive sample. No active membership is attached."}
        </p>
        {activeMembership(member) && (
          <form method="POST" action="/api/billing/portal">
            <button class="button secondary" type="submit">
              Manage or cancel subscription
            </button>
          </form>
        )}
        <p class="muted">
          Saved images download to your device. They are not stored in your
          account.
        </p>
      </section>
    </div>
  </section>
</Layout>
