---
import Layout from "../layouts/Layout.astro";
const checkoutMessage: Record<string, string> = {
  configuring: "Checkout is still being configured. No payment was taken.",
  news: "The news service is not ready. No payment was taken.",
  data: "The live market feed is not ready for all eight worlds. No payment was taken.",
  artwork: "One or more coin artworks are unavailable. No payment was taken.",
  "already-member":
    "You already have a membership. Manage it from your profile.",
  unavailable:
    "Checkout could not open. No payment was taken; please try again later.",
  pending:
    "You already have an open Checkout. Finish it or try again after it expires; no second payment was started.",
};
const notice = checkoutMessage[Astro.url.searchParams.get("checkout") ?? ""];
---

<Layout
  title="Pricing"
  description="Zahari monthly membership: one coin for $4.99, five for $8.99, or all eight launch coins for $12.99."
>
  <section class="pricing-page page-width">
    <p class="eyebrow">ZAHARI MEMBERSHIP</p>
    <h1>Choose the worlds you keep close.</h1>
    <p class="lead">
      Every tier is a monthly card subscription. The difference is how many of
      the eight launch coins you can select.
    </p>
    {notice && (
      <p class="form-status" role="alert">
        {notice}
      </p>
    )}
    <div class="plan-grid">
      <article class="plan-card">
        <span class="pill">ONE COIN</span>
        <h2>One</h2>
        <p class="plan-price">
          $4.99 <span>USD / month</span>
        </p>
        <p>One world to return to.</p>
        <ul class="feature-list">
          <li>Choose one launch coin</li>
          <li>Your world refreshes every 12 hours</li>
          <li>No news stories in this plan</li>
          <li>Keep your chosen coin until your next renewal</li>
          <li>Change the light, orbit and save a view</li>
        </ul>
      </article>
      <article class="plan-card featured">
        <span class="pill">FIVE COINS</span>
        <h2>Five</h2>
        <p class="plan-price">
          $8.99 <span>USD / month</span>
        </p>
        <p>A small constellation of your own.</p>
        <ul class="feature-list">
          <li>Choose five launch coins</li>
          <li>Worlds refresh every 8 hours</li>
          <li>News editions at 9am, 1pm and 9pm New York time</li>
          <li>Swap your chosen coins</li>
        </ul>
      </article>
      <article class="plan-card">
        <span class="pill">EIGHT COINS</span>
        <h2>Eight</h2>
        <p class="plan-price">
          $12.99 <span>USD / month</span>
        </p>
        <p>The whole launch collection.</p>
        <ul class="feature-list">
          <li>AAVE, BNB, BTC, ETH, LINK, SOL, UNI and XAUT</li>
          <li>Worlds refresh every 4 hours</li>
          <li>News editions at 9am, 1pm and 9pm New York time</li>
          <li>Swap your chosen coins</li>
        </ul>
      </article>
    </div>
    <div class="plan-grid">
      {(["one", "five", "eight"] as const).map((tier) => (
        <form method="POST" action="/api/billing/checkout">
          <input type="hidden" name="tier" value={tier} />
          <button class="button" type="submit">
            Subscribe to{" "}
            {tier === "one" ? "One" : tier === "five" ? "Five" : "Eight"}
          </button>
        </form>
      ))}
    </div>
    <p class="pricing-footnote">
      The public sample is separate from membership. Sign in before subscribing.
      A successful payment unlocks selection of your coin worlds. Market-driven
      changes and news require the data feed to be connected. A news story
      appears for up to one hour after it is found; if there is no relevant
      recent story, the panel stays empty.
    </p>
  </section>
</Layout>
