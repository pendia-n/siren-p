---
import Layout from "../layouts/Layout.astro";
import PasswordField from "../components/PasswordField.astro";
import PasscodeField from "../components/PasscodeField.astro";
---

<Layout title="Create account">
  <section class="auth-layout">
    <div class="auth-intro">
      <p class="eyebrow">A NEW PERSPECTIVE</p>
      <h1>
        A place
        <br />
        of your own.
      </h1>
      <p>
        No email required.
        <br />
        Just a username and a little curiosity.
      </p>
      <div class="auth-symbol" aria-hidden="true">
        z<span>•</span>
      </div>
    </div>
    <div class="form-card">
      <h2>Step inside</h2>
      <p>Create your free preview account.</p>
      <form method="post" data-auth-action="register">
        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            required
            pattern="[A-Za-z0-9_]{3,24}"
            maxlength="24"
            autocomplete="username"
            autocapitalize="none"
            spellcheck={false}
            data-availability
            aria-describedby="username-hint"
          />
          <small id="username-hint" data-username-hint aria-live="polite">
            3–24 letters, numbers or underscores.
          </small>
        </div>
        <PasswordField />
        <PasswordField label="Confirm password" name="confirmation" confirm />
        <div class="form-divider"></div>
        <PasscodeField />
        <label class="checkbox">
          <input type="checkbox" name="saved" required />
          <span>
            I have saved my recovery passcode somewhere safe. Without it, a
            forgotten password cannot be recovered.
          </span>
        </label>
        <p class="form-status" role="status" aria-live="polite"></p>
        <button class="button full" type="submit">
          Create account
        </button>
      </form>
      <p class="form-foot">
        Already have an account? <a href="/signin">Sign in</a>
      </p>
    </div>
  </section>
</Layout>
