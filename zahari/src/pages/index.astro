---
import Layout from "../layouts/Layout.astro";
import Viewer from "../components/Viewer.astro";
import Icon from "../components/Icon.astro";
---

<Layout>
  <section class="landing-hero">
    <div class="hero-copy">
      <p class="eyebrow">A FIRST LOOK / ZAHARI SAMPLE</p>
      <h1>
        Less scrolling.
        <br />
        More <em>wonder.</em>
      </h1>
      <p class="lead">
        An artwork to explore, with light and location at your fingertips. Step
        into the first little world of Zahari.
      </p>
      <a class="button" href="/signup">
        Make yourself at home <Icon name="arrow" />
      </a>
      <p class="fine-print">Free preview · No card required</p>
      <div class="hero-note">
        <span class="note-line"></span>
        <p>
          Built for a closer look.
          <br />
          Made for a moment of quiet.
        </p>
      </div>
    </div>
    <div class="hero-art">
      <Viewer sample />
      <div class="art-caption">
        <span>THE SAMPLE WORLD</span>
        <span>One world. Your point of view.</span>
      </div>
    </div>
  </section>
  <section class="intro-strip">
    <h2>A world, not a watchlist.</h2>
    <p>
      Turn the sample. Follow the light. Save a view worth keeping. This first
      preview is about exploring the art; live market data and news are not
      connected yet.
    </p>
    <a href="/about" class="text-link">
      Meet Zahari ↗
    </a>
  </section>
</Layout>
